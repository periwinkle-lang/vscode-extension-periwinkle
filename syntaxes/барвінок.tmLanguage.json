{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "Барвінок",
    "patterns": [
        { "include": "#hashbang" },
        { "include": "#comment" },
        { "include": "#function" },
        { "include": "#function_call" },
        { "include": "#keywords" },
        { "include": "#operators" },
        { "include": "#strings" },
        { "include": "#constants" },
        { "include": "#id" }
    ],
    "repository": {
        "hashbang": {
            "match": "\\A#!.*$",
            "name": "comment.line"
        },
        "function": {
            "begin": "\\b(функція)\\b\\s*([а-щА-ЩьюяїієґЬЮЯЇІЄҐ_][а-щА-ЩьюяїієґЬЮЯЇІЄҐ0-9_']*)\\s*\\(",
            "beginCaptures": {
                "1": {
                    "name": "keyword.control.барвінок"
                },
                "2": {
                    "name": "entity.name.function.барвінок"
                }
            },
            "end": "\\)",
            "patterns": [
                {
                    "match": "[а-щА-ЩьюяїієґЬЮЯЇІЄҐ_][а-щА-ЩьюяїієґЬЮЯЇІЄҐ0-9_']*",
                    "name": "variable.parameter.барвінок"
                },
                { "include": "#function_call" },
                { "include": "#operators" },
                { "include": "#strings" },
                { "include": "#constants" }
            ]
        },
        "function_call": {
            "match": "\\b[а-щА-ЩьюяїієґЬЮЯЇІЄҐ_][а-щА-ЩьюяїієґЬЮЯЇІЄҐ0-9_']*(?=\\()",
            "name": "entity.name.function.барвінок"
        },
        "keywords": {
            "patterns": [{
                "name": "keyword.control.барвінок",
                "match": "\\b(якщо|або|інакше|кінець|поки|пропустити|завершити|повернути|обійти|спробувати|обробити|як|наприкінці|жбурнути)\\b"
            }]
        },
        "operators": {
            "patterns": [
                {
                    "name": "keyword.operator.new.барвінок",
                    "match": "\\b(не рівно|рівно|не є|не|та|або|більше рівно|більше|менше рівно|менше|є)\\b"
                },
                {
                    "name": "keyword.operator.барвінок",
                    "match": "=|\\+=|-=|\\*=|/=|//=|%=|\\+|-|\\*|/|//|%"
                }
            ]
        },
        "strings": {
            "name": "string.quoted.double.барвінок",
            "begin": "\"",
            "end": "(\")|((?:[^\\\\\\n])$)",
            "endCaptures": {
                "2": {
                    "name": "invalid.illegal.барвінок"
                }
            },
            "patterns": [
                {
                    "name": "constant.character.escape.барвінок",
                    "match": "\\\\."
                }
            ]
        },
        "constants": {
            "patterns": [
                {
                    "match": "(0|([1-9][0-9]*))|(([0-9]+[.][0-9]*)|([0-9]*[.][0-9]+))",
                    "name": "constant.numeric.барвінок"
                },
                {
                    "match": "\\b(істина|хиба|ніц|КінецьІтерації)\\b",
                    "name": "constant.language.барвінок"
                }
            ]
        },
        "id": {
            "name": "variable",
            "match": "[а-щА-ЩьюяїієґЬЮЯЇІЄҐ_][а-щА-ЩьюяїієґЬЮЯЇІЄҐ0-9_']*"
        },
        "comment": {
            "name": "comment",
            "patterns": [{
                "name": "comment.line.барвінок",
                "match": "!.*$"
            }]
        }
    },
    "scopeName": "source.periwinkle"
}